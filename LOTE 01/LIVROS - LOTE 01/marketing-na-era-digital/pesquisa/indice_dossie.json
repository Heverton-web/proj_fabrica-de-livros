pitulo": 2.4277482359480516, "deve": 2.4277482359480516, "ancorar": 2.4277482359480516, "usar": 2.4277482359480516, "fonte": 2.4277482359480516, "primaria": 2.4277482359480516, "dado": 2.4277482359480516, "ga4": 2.4277482359480516, "relacao": 2.4277482359480516, "abordar": 2.4277482359480516, "fim": 2.4277482359480516}, "blocos": [{"arquivo": "dossie_marketing-na-era-digital.md", "titulo": "Dossiê de Pesquisa — Marketing na Era Digital: Conceitos, Plataformas e Estratégias", "texto": "**Slug:** `livros/marketing-na-era-digital`\n**Objeto:** Livro técnico (formato G — 20 capítulos planejados)\n**Persona-leitor:** Profissional de marketing e empreendedores que precisam dominar o ecossistema digital\n\n---", "urls": [], "id": "B0001", "tokens": {"dossie": 1, "pesquisa": 1, "marketing": 2, "digital": 2, "conceitos": 1, "plataformas": 1, "estrategias": 1, "slug": 1, "livros": 1, "marketing-na-era-digital": 1, "objeto": 1, "livro": 1, "tecnico": 1, "formato": 1, "capitulos": 1, "planejados": 1, "persona-leitor": 1, "profissional": 1, "empreendedores": 1, "precisam": 1, "dominar": 1, "ecossistema": 1}, "norma": 10.081481486198047}, {"arquivo": "dossie_marketing-na-era-digital.md", "titulo": "Resumo Executivo", "texto": "O marketing digital consolidou-se como a disciplina central da comunicação comercial contemporânea. A transição do marketing tradicional (outbound, canais de massa) para o digital (inbound, centrado em dados e relacionamento) reposicionou o consumidor como protagonista da jornada, transformou as plataformas em ecossistemas de negócio e elevou a mensuração a requisito de sobrevivência. Este dossiê reúne as fontes que fundamentam a obra: fundamentos teóricos (Kotler e Chaffey), documentação oficial das plataformas (Google, Meta), relatórios de indústria (Deloitte, HubSpot, Statista) e tendências tecnológicas (IA generativa, privacy-first, cookieless).", "urls": [], "id": "B0002", "tokens": {"resumo": 1, "executivo": 1, "marketing": 2, "digital": 2, "consolido