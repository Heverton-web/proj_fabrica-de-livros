 "autor": 1, "estrelas": 1, "28.4k": 1, "downloads": 1, "pypi": 1, "disponivel": 1, "pip": 1, "install": 1}, "norma": 14.099886127945009}, {"arquivo": "dossie_code-review-graph.md", "titulo": "Problema que Resolve", "texto": "Ferramentas de IA para code review gastam tokens desnecessários lendo partes grandes do repositório. O CRG resolve isso construindo um grafo de dependências que permite ao agente ler apenas os arquivos relevantes.", "urls": [], "id": "B0002", "tokens": {"problema": 1, "resolve": 2, "ferramentas": 1, "code": 1, "review": 1, "gastam": 1, "tokens": 1, "desnecessarios": 1, "lendo": 1, "partes": 1, "grandes": 1, "repositorio": 1, "crg": 1, "construindo": 1, "grafo": 1, "dependencias": 1, "permite": 1, "agente": 1, "ler": 1, "apenas": 1, "arquivos": 1, "relevantes": 1}, "norma": 9.393918710613558}, {"arquivo": "dossie_code-review-graph.md", "titulo": "Números Chave", "texto": "| Métrica | Valor |\n|---------|-------|\n| Redução mediana de tokens | ~65x |\n| Máximo de redução | 376x (fastapi) |\n| Ferramentas MCP | 30 |\n| Linguagens suportadas | 30+ |\n| Precisão F1 média | 0.69 |", "urls": [], "id": "B0003", "tokens": {"numeros": 1, "chave": 1, "metrica": 1, "valor": 1, "reducao": 2, "mediana": 1, "tokens": 1, "65x": 1, "maximo": 1, "376x": 1, "fastapi": 1, "ferramentas": 1, "mcp": 1, "linguagens": 1, "suportadas": 1, "precisao": 1, "media": 1, "0.69": 1}, "norma": 9.28488065712661}, {"arquivo": "dossie_code-review-graph.md", "titulo": "Arquitetura", "texto": "1. **Parseamento AST:** Tree-sitter converte código em árvore sintática\n2. **Grafo SQLite:** Nós (funções, classes, imports) + Arestas (chamadas, herança, testes)\n3. **Blast Radius:** Rastreia dependências afetadas por mudanças\n4. **MCP Server:** Expõe ferramentas para assistentes de IA", "urls": [], "id": "B0004", "tokens": {"arquitetura": 1, "parseamento": 1, "ast": 1, "tree-sitter": 1, "converte": 1, "codigo": 1, "arvore": 1, "sintatica": 1, "grafo": 1, "sqlite": 1, "funcoes": 1, "classes": 1, "imports": 1, "arestas": 1, "chamadas": 1, "heranca": 1, "testes": 1, "blast": 1, "radius": 1, "rastreia": 1, "dependencias": 1, "afetadas": 1, "mudancas": 1, "mcp": 1, "server": 1, "expoe": 1, "ferramentas": 1, "assistentes": 1}, "norma": 10.313038499050261}, {"arquivo": "dossie_code-review-graph.md", "titulo": "Blast Radius Analysis", "texto": "- Rastreia chamadores, dependentes e testes afetados\n- Retorna apenas arquivos relevantes para o agente\n- Economia de 71x no Flask (143.594 → 2.196 tokens)", "urls": [], "id": "B0005", "tokens": {"blast": 1, "radius": 1, "analysis": 1, "rastreia": 1, "chamadores": 1, "dependentes": 1, "testes": 1, "afetados": 1, "retorna": 1, "apenas": 1, "arquivos": 1, "relevantes": 1, "agente": 1, "economia": 1, "71x": 1, "flask": 1, "143.594": 1, "2.196": 1, "tokens": 1}, "norma": 8.348074993491526}, {"arquivo": "dossie_code-review-graph.md", "titulo": "Atualizações Incrementais", "texto": "- Re-parseia apenas arquivos com hash alterado\n- ~2.5s para edição de 2 arquivos em projeto de 3.000 arquivos\n- Hooks e watch mode mantêm grafo atualizado", "urls": [], "id": "B0006", "tokens": {"atualizacoes": 1, "incrementais": 1, "re-parseia": 1, "apenas": 1, "arquivos": 3, "hash": 1, "alterado": 1, "2.5s": 1, "edicao": 1, "projeto": 1, "3.000": 1, "hooks": 1, "watch": 1, "mode": 1, "mantem": 1, "grafo": 1, "atualizado": 1}, "norma": 8.970517597528158}, {"arquivo": "dossie_code-review-graph.md", "titulo": "Busca Semântica", "texto": "- Embeddings via sentence-transformers, Google Gemini, MiniMax ou OpenAI\n- Busca híbrida (keyword + similaridade vetorial)\n- FTS5-powered full-text search", "urls": [], "id": "B0007", "tokens": {"busca": 2, "semantica": 1, "embeddings": 1, "via": 1, "sentence-transformers": 1, "google": 1, "gemini": 1, "minimax": 1, "openai": 1, "hibrida": 1, "keyword": 1, "similaridade": 1, "vetorial": 1, "fts5-powered": 1, "full-text": 1, "search": 1}, "norma": 8.618603973992418}, {"arquivo": "dossie_code-review-graph.md", "titulo": "Visualização Interativa", "texto": "- D3.js force-directed graph\n- Exportação: GraphML, Neo4j Cypher, Obsidian, SVG\n- Detecção de hubs e bridges", "urls": [], "id": "B0008", "tokens": {"visualizacao": 1, "interativa": 1, "d3.js": 1, "force-directed": 1, "graph": 1, "exportacao": 1, "graphml": 1, "neo4j": 1, "cypher": 1, "obsidian": 1, "svg": 1, "deteccao": 1, "hubs": 1, "bridges": 1}, "norma": 8.11190853278739}, {"arquivo": "dossie_code-review-graph.md", "titulo": "30 Ferramentas MCP", "texto": "- `get_impact_radius` - Blast radius\n- `get_review_context` - Contexto otimizado\n- `detect_changes` - Análise de impacto\n- `query_graph` - Consultas ao grafo\n- `semantic_search_nodes` - Busca semântica\n- E mais 25 ferramentas", "urls": [], "id": "B0009", "tokens": {"ferramentas": 2, "mcp": 1, "get_impact_radius": 1, "blast": 1, "radius": 1, "get_review_context": 1, "contexto": 1, "otimizado": 1, "detect_changes": 1, "analise": 1, "impacto": 1, "query_graph": 1, "consultas": 1, "grafo": 1, "semantic_search_nodes": 1, "busca": 1, "semantica": 1}, "norma": 7.876575787007465}, {"arquivo": "dossie_code-review-graph.md", "titulo": "GitHub Action", "texto": "- Reviews automáticos em CI\n- Comentários sticky em PRs\n- Opção `fail-on-risk` como merge gate", "urls": [], "id": "B0010", "tokens": {"github": 1, "action": 1, "reviews": 1, "automaticos": 1, "comentarios": 1, "sticky": 1, "prs": 1, "opcao": 1, "fail-on-risk": 1, "merge": 1, "gate": 1}, "norma": 7.407987333395418}, {"arquivo": "dossie_code-review-graph.md", "titulo": "Plataformas Suportadas", "texto": "Claude Code, Cursor, Windsurf, Copilot, Gemini CLI, Zed, Continue, OpenCode, Antigravity, Qwen, Qoder, Kiro, CodeBuddy, Codex", "urls": [], "id": "B0011", "tokens": {"plataformas": 1, "suportadas": 1, "claude": 1, "code": 1, "cursor": 1, "windsurf": 1, "copilot": 1, "gemini": 1, "cli": 1, "zed": 1, "continue": 1, "opencode": 1, "antigravity": 1, "qwen": 1, "qoder": 1, "kiro": 1, "codebuddy": 1, "codex": 1}