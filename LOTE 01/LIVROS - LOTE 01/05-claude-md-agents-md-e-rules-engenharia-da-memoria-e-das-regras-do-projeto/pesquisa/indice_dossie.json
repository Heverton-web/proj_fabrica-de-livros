", "https://docs.anthropic.com/en/docs/claude-code/overview.", "https://docs.github.com/en/copilot/customizing-copilot/adding-repository-custom-instructions.", "https://github.blog/.", "https://github.com/modelcontextprotocol/registry.", "https://modelcontextprotocol.io/specification/2025-11-25/architecture.", "https://openai.com/index/introducing-codex/.", "https://www.anthropic.com/engineering/claude-code-best-practices.", "https://www.anthropic.com/engineering/effective-context-engineering-for-ai-agents.", "https://www.anthropic.com/engineering/writing-tools-for-agents.", "https://www.anthropic.com/news/model-context-protocol.", "https://www.augmentcode.com/guides/how-to-build-agents-md.", "https://www.linuxfoundation.org/blog/.", "https://www.linuxfoundation.org/press/linux-foundation-announces-the-formation-of-the-agentic-ai-foundation."], "id": "B0002", "tokens": {"fontes": 1, "autoritativas": 1, "anthropic": 10, "memory": 3, "how": 2, "claude": 6, "remembers": 1, "your": 1, "project": 1, "code": 8, "documentation": 7, "2025": 20, "2026": 37, "disponivel": 22, "https": 22, "docs.anthropic.com": 2, "docs": 5, "claude-code": 2, "acesso": 22, "ago": 23, "overview": 2, "agents.md": 10, "the": 4, "standard": 1, "for": 4, "agent": 2, "instructions": 3, "agentic": 6, "foundation": 10, "openai": 3, "linux": 5, "announces": 1, "formation": 1, "press": 2, "release": 1, "dez": 2, "www.linuxfoundation.org": 2, "linux-foundation-announces-the-formation-of-the-agentic-ai-foundation": 1, "official": 1, "portal": 1, "aaif": 1, "aaif.io": 1, "osmani": 2, "addy": 2, "engineering": 8, "guide": 2, "addyosmani.com": 1, "agents": 5, "15-agents-md": 1, "augment": 2, "build": 1, "construction": 1, "guides": 2, "www.augmentcode.com": 1, "how-to-build-agents-md": 1, "cursor": 5, "rules": 5, "anysphere": 1, "cursor.com": 2, "agyn": 2, "claude.md": 1, "does": 1, "codex": 2, "read": 1, "both": 1, "blog": 8, "jun": 1, "agyn.io": 1, "claude-md-agents-md-compatibility": 1, "10": 1, "and": 6, "coding": 2, "openai.com": 1, "index": 1, "introducing-codex": 1, "11": 1, "github": 9, "copilot": 3, "repository": 4, "support": 2, "docs.github.com": 1, "customizing-copilot": 1, "adding-repository-custom-instructions": 1, "12": 1, "reading": 1, "changelog": 1, "github.blog": 2, "13": 1, "writing": 1, "tools": 1, "using": 1, "set": 2, "www.anthropic.com": 4, "writing-tools-for-agents": 1, "14": 1, "effective": 1, "context": 6, "effective-context-engineering-for-ai-agents": 1, "15": 1, "introducing": 1, "model": 3, "protocol": 3, "news": 2, "nov": 2, "2024": 1, "model-context-protocol": 1, "16": 1, "architecture": 2, "mcp": 1, "specification": 2, "2025-11-25": 2, "modelcontextprotocol.io": 1, "17": 1, "governance": 1, "foundational": 1, "infrastructure": 1, "18": 1, "best": 2, "practices": 2, "19": 1, "aider": 2, "multi-tool": 1, "interoperability": 1, "aider.chat": 1, "repomap.html": 1, "20": 1, "configuration": 2, "claude-code-best-practices": 1, "21": 1, "codeql": 1, "reproducible": 1, "22": 1, "registry": 2, "github.com": 1, "modelcontextprotocol": 1}, "norma": 34.89237780803075}, {"arquivo": "dossie_claude-md-agents-md-e-rules-engenharia-da-memoria-e-das-regras-do-projeto.md", "titulo": "Eixo 1 — CLAUDE.md como contrato comportamental (Anthropic, 2025–2026)", "texto": "O CLAUDE.md não é documentação para humanos (como o README.md) — é um **contrato comportamental** escrito para o agente:\n- **O que colocar:** comandos críticos (`npm test`, lint, build, format), mapa de arquitetura e diretórios-chave, regras duras/negativas (\"nunca commitar `.env`\", \"sem class components\"), preferências de workflow e limites explícitos de escopo.\n- **O que nunca colocar:** segredos, tokens ou connection strings (aparecem no contexto e nos logs); regras já enforced por linter (Prettier/ESLint); aspirações vagas ou personalidade genérica (\"seja um engenheiro sênior\").\n- **Tamanho ideal:** menos de 200 linhas por arquivo (recomendação da Anthropic para evitar context bloat e garantir adesão); marcadores `IMPORTANT` e `YOU MUST` melhoram a adesão mensurada.\n- **Sintaxe:** `@path/to/import` importa arquivos externos (expandidos no launch, recursão até 4 hops); literais com backticks (`` `@README` ``); diretórios hierárquicos concatenados da raiz ao diretório de trabalho.", "urls": [], "id": "B0003", "tokens": {"eixo": 1, "claude.md": 2, "contrato": 2, "comportamental": 2, "anthropic": 2, "2025": 1, "2026": 1, "documentacao": 1, "humanos": 1, "readme.md": 1, "escrito": 1, "agente": 1, "colocar": 2, "comandos": 1, "criticos": 1, "npm": 1, "test": 1, "lint": 1, "build": 1, "format": 1, "mapa": 1, "arquitetura": 1, "diretorios-chave": 1, "regras": 2, "duras": 1, "negativas": 1, "nunca": 2, "commitar": 1, "env": 1, "class": 1, "components": 1, "preferencias": 1, "workflow": 1, "limites": 1, "explicitos": 1, "escopo": 1, "segredos": 1, "tokens": 1, "connection": 1, "strings": 1, "aparecem": 1, "contexto": 1, "logs": 1, "enforced": 1, "linter": 1, "prettier": 1, "eslint": 1, "aspiracoes": 1, "vagas": 1, "personalidade": 1, "generica": 1, "seja": 1, "engenheiro": 1, "senior": 1, "tamanho": 1, "ideal": 1, "menos": 1, "200": 1, "linhas": 1, "arquivo": 1, "recomendacao": 1, "evitar": 1, "context": 1, "bloat": 1, "garantir": 1, "adesao": 2, "marcadores": 1, "important": 1, "you": 1, "must": 1, "melhoram": 1, "mensurada": 1, "sintaxe": 1, "path": 1, "import": 1, "importa": 1, "arquivos": 1, "externos": 1, "expandidos": 1, "launch": 1, "recursao": 1, "hops": 1, "literais": 1, "backticks": 1, "readme": 1, "diretorios": 1, "hierarquicos": 1, "concatenados": 1, "raiz": 1, "diretorio": 1, "trabalho": 1}, "norma": 17.706778241316382}, {"arquivo": "dossie_claude-md-agents-md-e-rules-engenharia-da-memoria-e-das-regras-do-projeto.md", "titulo": "Eixo 2 — MEMORY.md e memória automática entre sessões", "texto": "- **Subsistema auto-memória:** habilitado por padrão (Claude Code v2.1.59+), grava aprendizados sob `~/.claude/projects/<projeto>/memory/`.\n- **Estrutura:** `MEMORY.md` como índice mestre (carregado até 200 linhas / 25 KB por sessão); arquivos tópico-específicos (ex.: `debugging.md`, `api-conventions.md`) lidos sob demanda via file tools.\n- **Consolidação (Dreams pipeline):** automação em períodos ociosos que mescla duplicatas, substitui entradas obsoletas/contraditórias pelos valores recentes e descobre novos insights dos transcripts de sessão.\n- **Subagentes:** memória automática localizada para tarefas isoladas, sem contaminar o thread principal.", "urls": [], "id": "B0004", "tokens": {"eixo": 1, "memory.md": 2, "memoria": 2, "automatica": 2, "sessoes": 1, "subsistema": 1, "auto-memoria": 1, "habilitado": 1, "padrao": 1, "claude": 2, "code": 1, "v2.1.59": 1, "grava": 1, "aprendizados": 1, "projects": 1, "projeto": 1, "memory": 1, "estrutura": 1, "indice": 1, "mestre": 1, "carregado": 1, "200": 1, "linhas": 1, "sessao": 2, "arquivos": 1, "topico-especificos": 1, "ex": 1, "debugging.md": 1, "api-conventions.md": 1, "lidos": 1, "demanda": 1, "via": 1, "file": 1, "tools": 1, "consolidacao": 1, "dreams": 1, "pipeline": 1, "automacao": 1, "periodos": 1, "ociosos": 1, "mescla": 1, "duplicatas": 1, "substitui": 1, "entradas": 1, "obsoletas": 1, "contraditorias": 1, "valores": 1, "recentes": 1, "descobre": 1, "novos": 1, "insights": 1, "transcripts": 1, "subagentes": 1, "localizada": 1, "tarefas": 1, "isoladas": 1, "contaminar": 1, "thread": 1, "principal": 1}, "norma": 13.878440466820626}, {"arquivo": "dossie_claude-md-agents-md-e-rules-engenharia-da-memoria-e-das-regras-do-projeto.md", "titulo": "Eixo 3 — AGENTS.md como padrão neutro (Agentic AI Foundation)", "texto": "- **Origem:** lançado pela OpenAI em agosto de 2025 como formato aberto; desenvolvido com Amp, Google (Jules), Cursor, Factory e Aider para eliminar arquivos de configuração fragmentados (`.cursorrules`, `CLAUDE.md`, `copilot-instructions.md`).\n- **Definição:** \"README para agentes\" — Markdown puro, sem schema proprietário, parseável por qualquer agente LLM.\n- **Conteúdo estrutural:** comandos exatos e completos (com flags), instruções de teste, estrutura do projeto, estilo de código e padrões não-óbvios, fronteiras e guardrails com tier de permissão (✅ Always · ⚠️ Ask First · 🚫 Never).\n- **Monorepos:** arquivos aninhados; o agente parseia o mais próximo (precedência por proximidade).\n- **Governança:** em 9 dez. 2025, a Linux Foundation anunciou a **Agentic AI Foundation (AAIF)** como casa neutra do AGENTS.md, do MCP (Anthropic) e do goose (Block); membros platinum incluem AWS, Anthropic, Bloomberg, Cloudflare, Google, Microsoft e OpenAI.", "urls": [], "id": "B0005", "tokens": {"eixo": 1, "agents.md": 2, "padrao": 1, "neutro": 1, "agentic": 2, "foundation": 3, "origem": 1, "lancado": 1, "openai": 2, "agosto": 1, "2025": 2, "formato": 1, "aberto": 1, "desenvolvido": 1, "amp": 1, "google": 2, "jules": 1, "cursor": 1, "factory": 1, "aider": 1, "eliminar": 1, "arquivos": 2, "configuracao": 1, "fragmentados": 1, "cursorrules": 1, "claude.md": 1, "copilot-instructions.md": 1, "definicao": 1, "readme": 1, "agentes": 1, "markdown": 1, "puro": 1, "schema": 1, "proprietario": 1, "parseavel": 1, "qualquer": 1, "agente": 2, "llm": 1, "conteudo": 1, "estrutural": 1, "comandos": 1, "exatos": 1, "completos": 1, "flags": 1, "instrucoes": 1, "teste": 1, "estrutura": 1, "projeto": 1, "estilo": 1, "codigo": 1, "padroes": 1, "nao-obvios": 1, "fronteiras": 1, "guardrails": 1, "tier": 1, "permissao": 1, "always": 1, "ask": 1, "first": 1, "never": 1, "monorepos": 1, "aninhados": 1, "parseia": 1, "proximo": 1, "precedencia": 1, "proximidade": 1, "governanca": 1, "dez": 1, "linux": 1, "anunciou": 1, "aaif": 1, "casa": 1, "neutra": 1, "mcp": 1, "anthropic": 2, "goose": 1, "block": 1, "membros": 1, "platinum": 1, "incluem": 1, "aws": 1, "bloomberg": 1, "cloudflare": 1, "microsoft": 1}, "norma": 15.095314249703096}, {"arquivo": "dossie_claude-md-agents-md-e-rules-engenharia-da-memoria-e-das-regras-do-projeto.md", "titulo": "Eixo 4 — .cursorrules e .cursor/rules/ (Cursor)", "texto": "- **Arquitetura modular:** arquivos `.mdc` (Markdown com frontmatter) em `.cursor/rules/` substituem/complementam o `.cursorrules` legado.\n- **Modos de ativação:** `alwaysApply: true` (sempre aplicado); `alwaysApply: false` + `globs` (auto-attached por glob); `alwaysApply: false` + `description` (agent-selected inteligente); manual via `@-mention`.\n- **Globs:** padrões `*`, `**`, `src/**/*.tsx`, `tailwind.config.*` para escopo por arquivo/diretório/linguagem.\n- **Precedência:** Team Rules (Cloud) → Project Rules (`.cursor/rules/` e `AGENTS.md`) → User Rules (Global).", "urls": [], "id": "B0006", "tokens": {"eixo": 1, "cursorrules": 2, "cursor": 4, "rules": 6, "arquitetura": 1, "modular": 1, "arquivos": 1, "mdc": 1, "markdown": 1, "frontmatter": 1, "substituem": 1, "complementam": 1, "legado": 1, "modos": 1, "ativacao": 1, "alwaysapply": 3, "true": 1, "sempre": 1, "aplicado": 1, "false": 2, "globs": 2, "auto-attached": 1, "glob": 1, "description": 1, "agent-selected": 1, "inteligente": 1, "manual": 1, "via": 1, "mention": 1, "padroes": 1, "src": 1, "tsx": 1, "tailwind.config": 1, "escopo": 1, "arquivo": 1, "diretorio": 1, "linguagem": 1, "precedencia": 1, "team": 1, "cloud": 1, "project": 1, "agents.md": 1, "user": 1, "global": 1}, "norma": 12.59681244978075}, {"arquivo": "dossie_claude-md-agents-md-e-rules-engenharia-da-memoria-e-das-regras-do-projeto.md", "titulo": "Eixo 5 — Hierarquia e cascata em monorepos", "texto": "- **Precedência por proximidade:** o arquivo mais próximo do diretório de trabalho vence (AGENTS.md aninhado, CLAUDE.md hierárquico concatenado da raiz).\n- **Padrão de ponte recomendado:** `AGENTS.md` como fonte canônica neutra (Cursor, OpenCode, Continue) + `CLAUDE.md` importando via `@AGENTS.md` com overrides específicos do Claude Code.\n- **Conflitos:** Claude Code lê `CLAUDE.md` e não faz fallback automático para `AGENTS.md`; a ponte explícita resolve a duplicação.", "urls": [], "id": "B0007", "tokens": {"eixo": 1, "hierarquia": 1, "cascata": 1, "monorepos": 1, "precedencia": 1, "proximidade": 1, "arquivo": 1, "proximo": 1, "diretorio": 1, "trabalho": 1, "vence": 1, "agents.md": 4, "aninhado": 1, "claude.md": 3, "hierarquico": 1, "concatenado": 1, "raiz": 1, "padrao": 1, "ponte": 2, "recomendado": 1, "fonte": 1, "canonica": 1, "neutra": 1, "cursor": 1, "opencode": 1, "continue": 1, "importando": 1, "via": 1, "overrides": 1, "especificos": 1, "claude": 2, "code": 2, "conflitos": 1, "faz": 1, "fallback": 1, "automatico": 1, "explicita": 1, "resolve": 1, "duplicacao": 1}, "norma": 10.410374117888828}, {"arquivo": "dossie_claude-md-agents-md-e-rules-engenharia-da-memoria-e-das-regras-do-projeto.md", "titulo": "Eixo 6 — Drift entre documentação e prática", "texto": "- **Rule drift:** os padrões do código evoluem, as regras estáticas envelhecem — agentes propõem padrões legados.\n- **Mitigação:** regras curtas e composáveis (< 500 linhas); **referenciar arquivos em vez de snippets** (`@filename.ts` aponta para implementações canônicas — o drift desaparece porque a referência fica fresca); atualização automatizada via CI/PR (tagging `@cursor` em PRs); verificação de carregamento de contexto (pedir ao agente que cite restrições no início da sessão).", "urls": [], "id": "B0008", "tokens": {"eixo": 1, "drift": 3, "documentacao": 1, "pratica": 1, "rule": 1, "padroes": 2, "codigo": 1, "evoluem": 1, "regras": 2, "estaticas": 1, "envelhecem": 1, "agentes": 1, "propoem": 1, "legados": 1, "mitigacao": 1, "curtas": 1, "composaveis": 1, "500": 1, "linhas": 1, "referenciar": 1, "arquivos": 1, "vez": 1, "snippets": 1, "filename.ts": 1, "aponta": 1, "implementacoes": 1, "canonicas": 1, "desaparece": 1, "porque": 1, "referencia": 1, "fica": 1, "fresca": 1, "atualizacao": 1, "automatizada": 1, "via": 1, "tagging": 1, "cursor": 1, "prs": 1, "verificacao": 1, "carregamento": 1, "contexto": 1, "pedir": 1, "agente": 1, "cite": 1, "restricoes": 1, "inicio": 1, "sessao": 1}, "norma": 12.362618936596496}, {"arquivo": "dossie_claude-md-agents-md-e-rules-engenharia-da-memoria-e-das-regras-do-projeto.md", "titulo": "3. Métricas de mercado (2026)", "texto": "- Anthropic recomenda **< 200 linhas por CLAUDE.md** e carrega **até 200 linhas / 25 KB** do MEMORY.md por sessão.\n- A **Agentic AI Foundation** (9 dez. 2025) reúne AGENTS.md, MCP e goose sob a Linux Foundation, com AWS, Anthropic, Bloomberg, Cloudflare, Google, Microsoft e OpenAI como membros platinum.\n- A integração do AGENTS.md é suportada por Claude Code, Cursor, Codex, GitHub Copilot, Aider, Google Jules, Gemini CLI, Zed, Warp, Factory, Goose, Windsurf e Augment Code.", "urls": [], "id": "B0009", "tokens": {"metricas": 1, "mercado": 1, "2026": 1, "anthropic": 2, "recomenda": 1, "200": 2, "linhas": 2, "claude.md": 1, "carrega": 1, "memory.md": 1, "sessao": 1, "agentic": 1, "foundation": 2, "dez": 1, "2025": 1, "reune": 1, "agents.md": 2, "mcp": 1, "goose": 2, "linux": 1, "aws": 1, "bloomberg": 1, "cloudflare": 1, "google": 2, "microsoft": 1, "openai": 1, "membros": 1, "platinum": 1, "integracao": 1, "suportada": 1, "claude": 1, "code": 2, "cursor": 1, "codex": 1, "github": 1, "copilot": 1, "aider": 1, "jules": 1, "gemini": 1, "cli": 1, "zed": 1, "warp": 1, "factory": 1, "windsurf": 1, "augment": 1}, "norma": 10.075940316562601}]}