ai/blog."], "id": "B0003", "tokens": {"frente": 1, "harness": 1, "engineering": 9, "context": 4, "anthropic": 8, "building": 2, "effective": 3, "agents": 3, "san": 6, "francisco": 6, "2024": 3, "disponivel": 6, "https": 6, "www.anthropic.com": 3, "building-effective-agents": 1, "for": 2, "2025": 2, "effective-context-engineering-for-ai-agents": 1, "writing": 1, "tools": 1, "writing-tools-for-agents": 1, "model": 1, "protocol": 1, "specification": 1, "and": 3, "documentation": 2, "modelcontextprotocol.io": 1, "langchain": 2, "langgraph": 2, "conceptual": 1, "guides": 1, "2024-2025": 1, "langchain-ai.github.io": 1, "liu": 1, "jerry": 1, "performant": 1, "agentic": 1, "rag": 1, "systems": 1, "llamaindex": 1, "www.llamaindex.ai": 1, "blog": 1}, "norma": 15.684860222515645}, {"arquivo": "dossie_09-harness-engineering.md", "titulo": "2. Frente B — Padrões de Orquestração de Agentes Autônomos", "texto": "Padrões de orquestração em produção: **supervisor/worker** (decomposição e delegação com\nisolamento de contexto), **planner-executor** (fases separadas, checkpoints de aprovação),\n**reflection/reflexão** (o agente avalia a própria saída antes de retornar), **ReAct**\n(raciocínio + ação em ciclo), **DAPER** (Detect–Analyze–Plan–Execute–Report para agentes\nproativos). Frameworks: LangGraph (grafos de estado, checkpointers, persistência),\nCrewAI (papéis/tarefas), OpenAI Agents SDK (handoffs), AWS Bedrock AgentCore, e execução\ndurável via Temporal (journal imutável, replay determinístico, idempotency keys).", "urls": [], "id": "B0004", "tokens": {"frente": 1, "padroes": 2, "orquestracao": 2, "agentes": 2, "autonomos": 1, "producao": 1, "supervisor": 1, "worker": 1, "decomposicao": 1, "delegacao": 1, "isolamento": 1, "contexto": 1, "planner-executor": 1, "fases": 1, "separadas": 1, "checkpoints": 1, "aprovacao": 1, "reflection": 1, "reflexao": 1, "agente": 1, "avalia": 1, "propria": 1, "saida": 1, "antes": 1, "retornar": 1, "react": 1, "raciocinio": 1, "acao": 1, "ciclo": 