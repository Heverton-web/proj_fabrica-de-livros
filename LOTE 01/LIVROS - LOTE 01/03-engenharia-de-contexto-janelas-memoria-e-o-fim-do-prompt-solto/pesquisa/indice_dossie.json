ing": 1, "tools": 1, "using": 1, "writing-tools-for-agents": 1, "memory": 2, "compaction": 1, "and": 1, "tool": 1, "clearing": 1, "claude": 1, "platform": 1, "cookbook": 2, "platform.claude.com": 1, "tool-use-context-engineering-context-engineering-tools": 1, "zhao": 1, "wayne": 1, "xin": 1, "2303.18223": 2, "2023": 3, "evaluation": 2, "toolkit": 1, "github": 2, "repository": 3, "github.com": 2, "chroma-core": 1, "10": 1, "replication": 1, "nelson-liu": 1, "lost-in-the-middle": 1, "11": 1, "chen": 1, "jiawei": 1, "longrag": 1, "enhancing": 1, "with": 3, "long-context": 2, "llms": 3, "2406.15319": 2, "12": 1, "asia": 1, "group": 1, "comprehensive": 1, "researchgate": 1, "abr": 1, "www.researchgate.net": 1, "publication": 1, "390991356": 1, "13": 1, "openai": 2, "gpt-4": 1, "developer": 1, "guides": 2, "management": 2, "documentation": 2, "openai.com": 1, "index": 1, "gpt-4-research": 1, "14": 1, "google": 2, "cloud": 2, "what": 1, "rag": 2, "architecture": 1, "center": 1, "cloud.google.com": 1, "use-cases": 1, "retrieval-augmented-generation": 1, "15": 1, "langchain": 3, "python.langchain.com": 1, "docs": 1, "concepts": 1, "16": 1, "wang": 1, "zhen": 1, "agentic": 2, "2408.12999": 2, "17": 1, "xiao": 1, "guangxuan": 1, "efficient": 1, "streaming": 1, "attention": 1, "sinks": 1, "2309.17453": 2, "18": 1, "rodin": 1, "alex": 1, "found": 1, "overcoming": 1, "vulnerabilities": 1, "2403.04797": 2, "19": 1, "medium": 2, "data": 1, "science": 1, "collective": 1, "new": 1, "prompt": 1, "why": 1, "shaping": 1, "future": 1, "article": 1, "medium.com": 1, "data-science-collective": 1, "context-is-the-new-prompt-why-context-engineering-is-shaping-the-future-of-ai-46eb062ed270": 1, "20": 1, "zenml": 1, "evaluating": 1, "degradation": 1, "mlops": 1, "database": 1, "www.zenml.io": 1, "llmops-database": 1, "context-rot-evaluating-llm-performance-degradation-with-increasing-input-tokens": 1, "21": 1, "model": 1, "protocol": 1, "mcp": 1, "open": 1, "standard": 1, "agent": 1, "integration": 1, "ecosystem": 1, "specs": 1, "modelcontextprotocol.io": 1, "22": 1, "hugging": 2, "face": 2, "open-source": 1, "compression": 1, "benchmarks": 1, "papers": 2, "spaces": 1, "huggingface.co": 1}, "norma": 42.873079221868075}, {"arquivo": "dossie_engenharia-de-contexto-janelas-memoria-e-o-fim-do-prompt-solto.md", "titulo": "Eixo 1 — Framework write/select/compress/isolate (Anthropic, 2025)", "texto": "A engenharia de contexto gerencia a totalidade do estado dinâmico durante inferências multi-turno:\n- **Write:** instruções em altitude ideal (nem regras if-else rígidas, nem generalizações vagas); ferramentas estruturadas com baixo acoplamento e alta eficiência de tokens.\n- **Select:** abandono do pré-processamento estático massivo em favor de referências leves (caminhos, links, metadados) que permitem ao agente explorar dados sob demanda via primitivas (glob, grep).\n- **Compress:** compactação e limpeza de resultados de ferramentas (tool result clearing) para resumir históricos longos preservando decisões e descartando saídas obsoletas.\n- **Isolate:** delegação de tarefas intensivas a subagentes com janelas de contexto dedicadas, retornando apenas resumos destilados ao agente principal.", "urls": [], "id": "B0003", "tokens": {"eixo": 1, "framework": 1, "write": 2, "select": 2, "compress": 2, "isolate": 2, "anthropic": 1, "2025": 1, "engenharia": 1, "contexto": 2, "gerencia": 1, "totalidade": 1, "estado": 1, "dinamico": 1, "durante": 1, "inferencias": 1, "multi-turno": 1, "instrucoes": 1, "altitude": 1, "ideal": 1, "regras": 1, "if-else": 1, "rigidas": 1, "generalizacoes": 1, "vagas": 1, "ferramentas": 2, "estruturadas": 1, "baixo": 1, "acoplamento": 1, "alta": 1, "eficiencia": 1, "tokens": 1, "abandono": 1, "pre-processamento": 1, "estatico": 1, "massivo": 1, "favor": 1, "referencias": 1, "leves": 1, "caminhos": 1, "links": 1, "metadados": 1, "permitem": 1, "agente": 2, "explorar": 1, "dados": 1, "demanda": 1, "via": 1, "primitivas": 1, "glob": 1, "grep": 1, "compactacao": 1, "limpeza": 1, "resultados": 1, "tool": 1, "result": 1, "clearing": 1, "resumir": 1, "historicos": 1, "longos": 1, "preservando": 1, "decisoes": 1, "descartando": 1, "saidas": 1, "obsoletas": 1, "delegacao": 1, "tarefas": 1, "intensivas": 1, "subagentes": 1, "janelas": 1, "dedicadas": 1, "retornando": 1, "apenas": 1, "resumos": 1, "destilados": 1, "principal": 1}, "norma": 16.73176810327544}, {"arquivo": "dossie_engenharia-de-contexto-janelas-memoria-e-o-fim-do-prompt-solto.md", "titulo": "Eixo 2 — Context Rot (Chroma, 2025)", "texto": "Janelas de 1M a 10M de tokens não geram melhoria linear de desempenho:\n- Degradação não-uniforme com o crescimento do volume de entrada, mesmo em tarefas simples.\n- Similaridade agulha-pergunta impacta a degradação; pares menos similares aceleram a falha.\n- Distratores (conteúdos topologicamente semelhantes ao alvo, porém incorretos) degradam severamente a acurácia — orçamento de atenção O(n²) esgota.", "urls": [], "id": "B0004", "tokens": {"eixo": 1, "context": 1, "rot": 1, "chroma": 1, "2025": 1, "janelas": 1, "10m": 1, "tokens": 1, "geram": 1, "melhoria": 1, "linear": 1, "desempenho": 1, "degradacao": 2, "nao-uniforme": 1, "crescimento": 1, "volume": 1, "entrada": 1, "tarefas": 1, "simples": 1, "similaridade": 1, "agulha-pergunta": 1, "impacta": 1, "pares": 1, "menos": 1, "similares": 1, "aceleram": 1, "falha": 1, "distratores": 1, "conteudos": 1, "topologicamente": 1, "semelhantes": 1, "alvo": 1, "porem": 1, "incorretos": 1, "degradam": 1, "severamente": 1, "acuracia": 1, "orcamento": 1, "atencao": 1, "esgota": 1}, "norma": 11.648993794868836}, {"arquivo": "dossie_engenharia-de-contexto-janelas-memoria-e-o-fim-do-prompt-solto.md", "titulo": "Eixo 3 — RAG (Lewis 2020 → Gao 2024 → Wang 2024)", "texto": "- Fundação: memória paramétrica (modelo) + memória não-paramétrica (índice vetorial recuperado).\n- Eras: Naive RAG → Advanced RAG (pré/pós-processamento) → Modular RAG (roteamento adaptativo).\n- Limitação central: atrito entre ruído dos documentos recuperados e limites de atenção → Agentic RAG.", "urls": [], "id": "B0005", "tokens": {"eixo": 1, "rag": 5, "lewis": 1, "2020": 1, "gao": 1, "2024": 2, "wang": 1, "fundacao": 1, "memoria": 2, "parametrica": 1, "modelo": 1, "nao-parametrica": 1, "indice": 1, "vetorial": 1, "recuperado": 1, "eras": 1, "naive": 1, "advanced": 1, "pre": 1, "pos-processamento": 1, "modular": 1, "roteamento": 1, "adaptativo": 1, "limitacao": 1, "central": 1, "atrito": 1, "ruido": 1, "documentos": 1, "recuperados": 1, "limites": 1, "atencao": 1, "agentic": 1}, "norma": 10.975422882970037}, {"arquivo": "dossie_engenharia-de-contexto-janelas-memoria-e-o-fim-do-prompt-solto.md", "titulo": "Eixo 4 — Subagentes e isolamento", "texto": "- Arquiteturas multi-agente separam exploração detalhada do planejamento de alto nível.\n- Subagentes operam em contextos isolados (dezenas de milhares de tokens) e entregam resumos de 1.000–2.000 tokens ao coordenador.", "urls": [], "id": "B0006", "tokens": {"eixo": 1, "subagentes": 2, "isolamento": 1, "arquiteturas": 1, "multi-agente": 1, "separam": 1, "exploracao": 1, "detalhada": 1, "planejamento": 1, "alto": 1, "nivel": 1, "operam": 1, "contextos": 1, "isolados": 1, "dezenas": 1, "milhares": 1, "tokens": 2, "entregam": 1, "resumos": 1, "1.000": 1, "2.000": 1, "coordenador": 1}, "norma": 9.025969315106803}, {"arquivo": "dossie_engenharia-de-contexto-janelas-memoria-e-o-fim-do-prompt-solto.md", "titulo": "Eixo 5 — Memória, cache e janelas", "texto": "- Lost in the Middle (Liu et al., 2024): precisão alta no início/fim do contexto, falha no meio.\n- Prompt caching (OpenAI) e Attention Sinks (Xiao et al., 2023) para custos sustentáveis.", "urls": [], "id": "B0007", "tokens": {"eixo": 1, "memoria": 1, "cache": 1, "janelas": 1, "lost": 1, "the": 1, "middle": 1, "liu": 1, "al": 2, "2024": 1, "precisao": 1, "alta": 1, "inicio": 1, "fim": 1, "contexto": 1, "falha": 1, "meio": 1, "prompt": 1, "caching": 1, "openai": 1, "attention": 1, "sinks": 1, "xiao": 1, "2023": 1, "custos": 1, "sustentaveis": 1}, "norma": 7.730279940270764}, {"arquivo": "dossie_engenharia-de-contexto-janelas-memoria-e-o-fim-do-prompt-solto.md", "titulo": "Eixo 6 — Métricas de sucesso", "texto": "- Precisão de recuperação e relevância (signal-to-noise ratio).\n- Taxa de conclusão de tarefa em benchmarks de agentes; contexto mal curado induz alucinação por exaustão de atenção.", "urls": [], "id": "B0008", "tokens": {"eixo": 1, "metricas": 1, "sucesso": 1, "precisao": 1, "recuperacao": 1, "relevancia": 1, "signal-to-noise": 1, "ratio": 1, "taxa": 1, "conclusao": 1, "tarefa": 1, "benchmarks": 1, "agentes": 1, "contexto": 1, "mal": 1, "curado": 1, "induz": 1, "alucinacao": 1, "exaustao": 1, "atencao": 1}, "norma": 7.595355860710755}, {"arquivo": "dossie_engenharia-de-contexto-janelas-memoria-e-o-fim-do-prompt-solto.md", "titulo": "Eixo 7 — Diagnóstico de falhas", "texto": "1. **Falha de prompt:** instruções ambíguas/contraditórias → refinamento de system prompts.\n2. **Falha de contexto:** informação presente mas perdida (Lost in the Middle, distratores, excesso de tokens) → compactação, remoção de histórico de ferramentas, busca agêntica.\n3. **Falha de modelo/ferramenta:** falta de capacidade de raciocínio ou esquemas de dados mal formatados → mudança de modelo ou correção da ferramenta.", "urls": [], "id": "B0009", "tokens": {"eixo": 1, "diagnostico": 1, "falhas": 1, "falha": 3, "prompt": 1, "instrucoes": 1, "ambiguas": 1, "contraditorias": 1, "refinamento": 1, "system": 1, "prompts": 1, "contexto": 1, "informacao": 1, "presente": 1, "perdida": 1, "lost": 1, "the": 1, "middle": 1, "distratores": 1, "excesso": 1, "tokens": 1, "compactacao": 1, "remocao": 1, "historico": 1, "ferramentas": 1, "busca": 1, "agentica": 1, "modelo": 2, "ferramenta": 2, "falta": 1, "capacidade": 1, "raciocinio": 1, "esquemas": 1, "dados": 1, "mal": 1, "formatados": 1, "mudanca": 1, "correcao": 1}, "norma": 11.266454391571235}, {"arquivo": "dossie_engenharia-de-contexto-janelas-memoria-e-o-fim-do-prompt-solto.md", "titulo": "3. Métricas de mercado (2026)", "texto": "- Contexto bem curado eleva a acurácia de tarefas de agentes de ~30% (contexto bruto) para ~90% (contexto curado) em benchmarks de desenvolvimento de software e análise de dados.\n- O framework write/select/compress/isolate é a base das práticas de produção documentadas pela Anthropic em set. 2025.", "urls": [], "id": "B0010", "tokens": {"metricas": 1, "mercado": 1, "2026": 1, "contexto": 3, "bem": 1, "curado": 2, "eleva": 1, "acuracia": 1, "tarefas": 1, "agentes": 1, "bruto": 1, "benchmarks": 1, "desenvolvimento": 1, "software": 1, "analise": 1, "dados": 1, "framework": 1, "write": 1, "select": 1, "compress": 1, "isolate": 1, "base": 1, "praticas": 1, "producao": 1, "documentadas": 1, "anthropic": 1, "set": 1, "2025": 1}, "norma": 8.848241794115815}]}