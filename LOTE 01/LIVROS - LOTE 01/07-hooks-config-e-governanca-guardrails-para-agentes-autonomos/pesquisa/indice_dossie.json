otocol.io": 1.791759469228055, "google": 1.791759469228055, "application": 1.791759469228055, "kernel": 1.791759469228055, "containers": 1.791759469228055, "gvisor.dev": 1.791759469228055, "best": 1.791759469228055, "practices": 1.791759469228055, "docs.docker.com": 1.791759469228055, "engine": 1.791759469228055, "cheat": 1.791759469228055, "sheet": 1.791759469228055, "cheatsheetseries.owasp.org": 1.791759469228055, "cheatsheets": 1.791759469228055, "prompt_injection_cheat_sheet.html": 1.791759469228055, "cursor.com": 1.791759469228055, "extension": 1.791759469228055}, "blocos": [{"arquivo": "dossie_07-hooks-config-e-governanca.md", "titulo": "Dossiê Técnico — Hooks, Config e Governança: Guardrails para Agentes Autônomos", "texto": "**Obra:** Livro 7 · Parte III — A Camada de Harness\n**Slug:** livros/07-hooks-config-e-governanca-guardrails-para-agentes-autonomos\n**Tamanho:** G (5 Partes, 10 capítulos) · **Refs mínimas por capítulo:** 20", "urls": [], "id": "B0001", "tokens": {"dossie": 1, "tecnico": 1, "hooks": 1, "config": 1, "governanca": 1, "guardrails": 1, "agentes": 1, "autonomos": 1, "obra": 1, "livro": 1, "parte": 1, "iii": 1, "camada": 1, "harness": 1, "slug": 1, "livros": 1, "07-hooks-config-e-governanca-guardrails-para-agentes-autonomos": 1, "tamanho": 1, "partes": 1, "capitulos": 1, "refs": 1, "minimas": 1, "capitulo": 1}, "norma": 7.251698166133896}, {"arquivo": "dossie_07-hooks-config-e-governanca.md", "titulo": "1. Síntese do tema", "texto": "O Livro 6 fechou a camada de empacotamento de conhecimento (skills e commands). O Livro 7\navança para a camada de **controle determinístico**: hooks, configuração e governança como\nguardrails de segurança para agentes autônomos. A tese central: instruções em linguagem\nnatural (CLAUDE.md, rules) dependem da probabilidade do modelo obedecer; hooks e permissões\nexecutam **no harness**, de forma determinística e inegociável, independentemente do que o\nmodelo \"decida\". É a diferença entre pedir e impor.", "urls": [], "id": "B0002", "tokens": {"sintese": 1, "tema": 1, "livro": 2, "fechou": 1, "camada": 2, "empacotamento": 1, "conhecimento": 1, "skills": 1, "commands": 1, "avanca": 1, "controle": 1, "deterministico": 1, "hooks": 2, "configuracao": 1, "governanca": 1, "guardrails": 1, "seguranca": 1, "agentes": 1, "autonomos": 1, "tese": 1, "central": 1, "instrucoes": 1, "linguagem": 1, "natural": 1, "claude.md": 1, "rules": 1, "dependem": 1, "probabilidade": 1, "modelo": 2, "obedecer": 1, "permissoes": 1, "executam": 1, "harness": 1, "forma": 1, "deterministica": 1, "inegociavel": 1, "independentemente": 1, "decida": 1, "diferenca": 1, "pedir": 1, "impor": 1}, "norma": 10.160607814355249}, {"arquivo": "dossie_07-hooks-config-e-governanca.md", "titulo": "1.1 Conceitos fundamentais", "texto": "- **Hook:** ponto de interceptação programática no ciclo de vida do agente (antes/depois de\n  ferramentas, entrada de prompt, início/fim de sessão, subagentes). Executa comandos shell,\n  endpoints HTTP, prompts LLM ou subagentes, com contrato de saída em JSON + exit codes.\n- **Exit code 2:** código de bloqueio imediato — interrompe a ação e devolve o stderr ao\n  modelo como motivo do bloqueio (loop de auto-correção forçada).\n- **Matchers:** filtros de disparo por nome de ferramenta (case-sensitive, regex), caminho de\n  arquivo, regex de comando ou hook-source.\n- **hookSpecificOutput:** saída JSON refinada do PreToolUse com `permissionDecision`\n  (allow/deny/ask), `updatedInput` (reescrita de argumentos) e `additionalContext`\n  (injeção de contexto).\n- **Scopes de settings.json:** managed (empresa) > CLI args > local > projeto > usuário.\n- **Camada de permissões:** avaliação estrita Deny → Ask → Allow; deny nu remove a ferramenta\n  do contexto do modelo; deny por escopo bloqueia apenas o comando correspondente.\n- **Modos de permissão:** default, acceptEdits, plan, auto, dontAsk, bypassPermissions.\n- **Governança enterprise:** managed policy (MDM, servidor, arquivos de sistema),\n  `allowManagedPermissionRulesOnly`, `permissions.disableBypassPermissionsMode`,\n  sandbox OS-level, SSO/SCIM, audit logs (180 dias) e Compliance API para SIEM.\n- **Modelo de ameaças agentic:** indirect prompt injection, tool poisoning, data exfiltration\n  via ferramentas, privilege/identity abuse, rogue agents, cascading failures.\n- **Princípio de Least Agency:** evolução do least privilege — o agente começa com o menor\n  grau de autonomia e ganha agência conforme demonstra confiabilidade.\n- **OWASP Top 10 for Agentic Applications (2026):** ASI01 Goal Hijack, ASI02 Tool Misuse,\n  ASI08 Cascading Failures, ASI10 Rogue Agents.\n- **MITRE ATLAS:** táticas/técnicas adversárias contra sistemas de IA, com cobertura de\n  plano de controle de agentes, persistência de contexto e envenenamento de toolchain.\n- **Sandboxing:** Docker efêmero com egress deny-by-default, gVisor (isolamento de syscalls),\n  namespaces + cgroups, sandbox OS-level do Claude Code (`sandbox.enabled`).", "urls": [], "id": "B0003", "tokens": {"1.1": 1, "conceitos": 1, "fundamentais": 1, "hook": 1, "ponto": 1, "interceptacao": 1, "programatica": 1, "ciclo": 1, "vida": 1, "agente": 2, "antes": 1, "ferramentas": 2, "entrada": 1, "prompt": 2, "inicio": 1, "fim": 1, "sessao": 1, "subagentes": 2, "executa": 1, "comandos": 1, "shell": 1, "endpoints": 1, "http": 1, "prompts": 1, "llm": 1, "contrato": 1, "saida": 2, "json": 2, "exit": 2, "codes": 1, "code": 2, "codigo": 1, "bloqueio": 2, "imediato": 1, "interrompe": 1, "acao": 1, "devolve": 1, "stderr": 1, "modelo": 3, "motivo": 1, "loop": 1, "auto-correcao": 1, "forcada": 1, "matchers": 1, "filtros": 1, "disparo": 1, "nome": 1, "ferramenta": 2, "case-sensitive": 1, "regex": 2, "caminho": 1, "arquivo": 1, "comando": 2, "hook-source": 1, "hookspecificoutput": 1, "refinada": 1, "pretooluse": 1, "permissiondecision": 1, "allow": 2, "deny": 4, "ask": 2, "updatedinput": 1, "reescrita": 1, "argumentos": 1, "additionalcontext": 1, "injecao": 1, "contexto": 3, "scopes": 1, "settings.json": 1, "managed": 2, "empresa": 1, "cli": 1, "args": 1, "local": 1, "projeto": 1, "usuario": 1, "camada": 1, "permissoes": 1, "avaliacao": 1, "estrita": 1, "remove": 1, "escopo": 1, "bloqueia": 1, "apenas": 1, "correspondente": 1, "modos": 1, "permissao": 1, "default": 1, "acceptedits": 1, "plan": 1, "auto": 1, "dontask": 1, "bypasspermissions": 1, "governanca": 1, "enterprise": 1, "policy": 1, "mdm": 1, "servidor": 1, "arquivos": 1, "sistema": 1, "allowmanagedpermissionrulesonly": 1, "permissions.disablebypasspermissionsmode": 1, "sandbox": 2, "os-level": 2, "sso": 1, "scim": 1, "audit": 1, "logs": 1, "180": 1, "dias": 1, "compliance": 1, "api": 1, "siem": 1, "ameacas": 1, "agentic": 2, "indirect": 1, "injection": 1, "tool": 2, "poisoning": 1, "data": 1, "exfiltration": 1, "via": 1, "privilege": 2, "identity": 1, "abuse": 1, "rogue": 2, "agents": 2, "cascading": 2, "failures": 2, "principio": 1, "least": 2, "agency": 1, "evolucao": 1, "comeca": 1, "menor": 1, "grau": 1, "autonomia": 1, "ganha": 1, "agencia": 1, "conforme": 1, "demonstra": 1, "confiabilidade": 1, "owasp": 1, "top": 1, "for": 1, "applications": 1, "2026": 1, "asi01": 1, "goal": 1, "hijack": 1, "asi02": 1, "misuse": 1, "asi08": 1, "asi10": 1, "mitre": 1, "atlas": 1, "taticas": 1, "tecnicas": 1, "adversarias": 1, "contra": 1, "sistemas": 1, "cobertura": 1, "plano": 1, "controle": 1, "agentes": 1, "persistencia": 1, "envenenamento": 1, "toolchain": 1, "sandboxing": 1, "docker": 1, "efemero": 1, "egress": 1, "deny-by-default": 1, "gvisor": 1, "isolamento": 1, "syscalls": 1, "namespaces": 1, "cgroups": 1, "claude": 1, "sandbox.enabled": 1}, "norma": 24.120868720397578}, {"arquivo": "dossie_07-hooks-config-e-governanca.md", "titulo": "Frente A — Sistema de hooks do Claude Code", "texto": "- ~30 eventos de ciclo de vida: SessionStart, SessionEnd, Setup, ConfigChange, CwdChanged,\n  InstructionsLoaded, UserPromptSubmit, UserPromptExpansion, PreToolUse, PermissionRequest,\n  PermissionDenied, PostToolUse, PostToolUseFailure, PostToolBatch, SubagentStart,\n  SubagentStop, TaskCreated, TaskCompleted, TeammateIdle, Stop, PreCompact, PostCompact.\n- Tipos de handler: `command` (shell), `http` (POST JSON), `prompt` (LLM de um turno),\n  `agent` (subagente com ferramentas).\n- PreToolUse é o hook mais crítico para segurança: bloqueia antes de Bash/Edit/Write.\n- Stop pode recusar o fim de turno (força o modelo a continuar até passar nos testes).\n- SessionStart suporta matcher por source (startup, resume, clear, compact).\n- Configuração em bloco `\"hooks\"` dentro de settings.json nos 4 escopos.", "urls": [], "id": "B0004", "tokens": {"frente": 1, "sistema": 1, "hooks": 2, "claude": 1, "code": 1, "eventos": 1, "ciclo": 1, "vida": 1, "sessionstart": 2, "sessionend": 1, "setup": 1, "configchange": 1, "cwdchanged": 1, "instructionsloaded": 1, "userpromptsubmit": 1, "userpromptexpansion": 1, "pretooluse": 2, "permissionrequest": 1, "permissiondenied": 1, "posttooluse": 1, "posttoolusefailure": 1, "posttoolbatch": 1, "subagentstart": 1, "subagentstop": 1, "taskcreated": 1, "taskcompleted": 1, "teammateidle": 1, "stop": 2, "precompact": 1, "postcompact": 1, "tipos": 1, "handler": 1, "command": 1, "shell": 1, "http": 1, "post": 1, "json": 1, "prompt": 1, "llm": 1, "turno": 2, "agent": 1, "subagente": 1, "ferramentas": 1, "hook": 1, "critico": 1, "seguranca": 1, "bloqueia": 1, "antes": 1, "bash": 1, "edit": 1, "write": 1, "pode": 1, "recusar": 1, "fim": 1, "forca": 1, "modelo": 1, "continuar": 1, "passar": 1, "testes": 1, "suporta": 1, "matcher": 1, "source": 1, "startup": 1, "resume": 1, "clear": 1, "compact": 1, "configuracao": 1, "bloco": 1, "dentro": 1, "settings.json": 1, "escopos": 1}, "norma": 14.095175791704632}, {"arquivo": "dossie_07-hooks-config-e-governanca.md", "titulo": "Frente B — Configuração e permissões", "texto": "- Escopo managed é absoluto: não pode ser sobrescrito por desenvolvedores.\n- `additionalDirectories` habilita monorepos/pastas irmãs com controle explícito.\n- `/permissions` e `/config` são os comandos de gestão interativa de regras.\n- \"Yes, don't ask again\" grava regra permanente em `.claude/settings.local.json`\n  (que é auto-adicionado ao .gitignore).\n- `--allowedTools`/`--disallowedTools`/`--permission-mode` para CI headless.\n- `--dangerously-skip-permissions` = bypassPermissions; alerta de disjuntor só para\n  `rm -rf /` e `~`; deve ser usado apenas em ambientes isolados.\n- Sandbox OS-level: `sandbox.enabled`, `sandbox.network.allowedDomains`.", "urls": [], "id": "B0005", "tokens": {"frente": 1, "configuracao": 1, "permissoes": 1, "escopo": 1, "managed": 1, "absoluto": 1, "pode": 1, "sobrescrito": 1, "desenvolvedores": 1, "additionaldirectories": 1, "habilita": 1, "monorepos": 1, "pastas": 1, "irmas": 1, "controle": 1, "explicito": 1, "permissions": 1, "config": 1, "sao": 1, "comandos": 1, "gestao": 1, "interativa": 1, "regras": 1, "yes": 1, "don": 1, "ask": 1, "again": 1, "grava": 1, "regra": 1, "permanente": 1, "claude": 1, "settings.local.json": 1, "auto-adicionado": 1, "gitignore": 1, "allowedtools": 1, "disallowedtools": 1, "permission-mode": 1, "headless": 1, "dangerously-skip-permissions": 1, "bypasspermissions": 1, "alerta": 1, "disjuntor": 1, "deve": 1, "usado": 1, "apenas": 1, "ambientes": 1, "isolados": 1, "sandbox": 1, "os-level": 1, "sandbox.enabled": 1, "sandbox.network.alloweddomains": 1}, "norma": 11.43436083779901}, {"arquivo": "dossie_07-hooks-config-e-governanca.md", "titulo": "Frente C — Governança e guardrails para agentes autônomos", "texto": "- Superfície de ataque dos agentes: input estático → planejamento iterativo + ferramentas.\n- Human-in-the-loop com approval gates para operações destrutivas; CIBA para\n  autorização assíncrona em canal externo.\n- Circuit breakers/kill switches contra anomalias (volume de API, desvio de plano).\n- Audit trails com cadeia de delegação (usuário → orquestrador → subagentes), logs imutáveis.\n- Frameworks: OWASP Top 10 for Agentic Applications, OWASP Top 10 for LLM Applications,\n  MITRE ATLAS, NIST AI RMF, ISO/IEC 42001, EU AI Act (artigos 9, 14, 15).", "urls": [], "id": "B0006", "tokens": {"frente": 1, "governanca": 1, "guardrails": 1, "agentes": 2, "autonomos": 1, "superficie": 1, "ataque": 1, "input": 1, "estatico": 1, "planejamento": 1, "iterativo": 1, "ferramentas": 1, "human-in-the-loop": 1, "approval": 1, "gates": 1, "operacoes": 1, "destrutivas": 1, "ciba": 1, "autorizacao": 1, "assincrona": 1, "canal": 1, "externo": 1, "circuit": 1, "breakers": 1, "kill": 1, "switches": 1, "contra": 1, "anomalias": 1, "volume": 1, "api": 1, "desvio": 1, "plano": 1, "audit": 1, "trails": 1, "cadeia": 1, "delegacao": 1, "usuario": 1, "orquestrador": 1, "subagentes": 1, "logs": 1, "imutaveis": 1, "frameworks": 1, "owasp": 2, "top": 2, "for": 2, "agentic": 1, "applications": 2, "llm": 1, "mitre": 1, "atlas": 1, "nist": 1, "rmf": 1, "iso": 1, "iec": 1, "42001": 1, "act": 1, "artigos": 1}, "norma": 11.376457356197113}, {"arquivo": "dossie_07-hooks-config-e-governanca.md", "titulo": "Frente D — Comparativo de harnesses", "texto": "- Claude Code: settings.json cascata + CLAUDE.md; Deny>Ask>Allow; hooks JSON/exit codes;\n  approval interativo persistente.\n- OpenCode: config.json central, plugins, allowlists/denylists, hooks programáticos.\n- Cursor: `.cursor/rules/*.mdc` com glob patterns (applyTo), delegação a extensões.\n- Copilot: `copilot-instructions.md`, `*.instructions.md`, AGENTS.md; guardrails na nuvem.\n- Windsurf/Cascade: `.windsurfrules`, hooks.json com 12 eventos, exit code 2 bloqueia.\n- Cline/Roo Code: auto-approve por categoria de risco, longest-prefix wins para\n  allowedCommands/deniedCommands, dupla aprovação para MCP.", "urls": [], "id": "B0007", "tokens": {"frente": 1, "comparativo": 1, "harnesses": 1, "claude": 1, "code": 3, "settings.json": 1, "cascata": 1, "claude.md": 1, "deny": 1, "ask": 1, "allow": 1, "hooks": 2, "json": 1, "exit": 2, "codes": 1, "approval": 