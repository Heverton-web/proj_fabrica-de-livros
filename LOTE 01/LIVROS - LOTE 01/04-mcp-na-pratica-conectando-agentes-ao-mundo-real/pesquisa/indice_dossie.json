rver Directory*. PulseMCP, 2025–2026. Disponível em: https://www.pulsemcp.com/servers. Acesso em: 5 ago. 2026.", "urls": ["https://arxiv.org/html/2508.12538v1.", "https://blog.modelcontextprotocol.io/posts/2025-09-08-mcp-registry-preview/.", "https://github.blog/changelog/2025-09-16-github-mcp-registry-the-fastest-way-to-discover-ai-tools/.", "https://github.com/modelcontextprotocol/python-sdk.", "https://github.com/modelcontextprotocol/registry.", "https://github.com/modelcontextprotocol/typescript-sdk.", "https://invariantlabs.ai/blog/mcp-security-notification-tool-poisoning-attacks.", "https://labs.cloudsecurityalliance.org/agentic/agentic-mcp-security-best-practices-v1/.", "https://modelcontextprotocol.io/docs/quickstart/quickstart.", "https://modelcontextprotocol.io/specification/2025-11-25/architecture.", "https://modelcontextprotocol.io/specification/2025-11-25/basic/transports.", "https://modelcontextprotocol.io/specification/2026-07-28/server/resources.", "https://modelcontextprotocol.io/specification/2026-07-28/server/tools.", "https://modelcontextprotocol.io/specification/draft/basic/security_best_practices.", "https://py.sdk.modelcontextprotocol.io/.", "https://simonwillison.net/2025/Apr/9/mcp-prompt-injection/.", "https://ts.sdk.modelcontextprotocol.io/.", "https://www.anthropic.com/news/model-context-protocol.", "https://www.cisa.gov/news-events/news/cisa-us-and-international-partners-release-guide-secure-adoption-agentic-ai.", "https://www.cisecurity.org/insights/white-papers/controls-v8-1-model-context-protocol-companion-guide.", "https://www.nsa.gov/Press-Room/Press-Releases-Statements/Press-Release-View/Article/4496698/.", "https://www.pulsemcp.com/servers."], "id": "B0002", "tokens": {"fontes": 1, "autoritativas": 1, "anthropic": 2, "introducing": 1, "the": 3, "model": 16, "context": 16, "protocol": 16, "news": 4, "nov": 2, "2024": 1, "disponivel": 22, "https": 22, "www.anthropic.com": 1, "model-context-protocol": 1, "acesso": 22, "ago": 23, "2026": 34, "architecture": 2, "mcp": 16, "specification": 13, "2025-11-25": 4, "2025": 10, "modelcontextprotocol.io": 6, "basic": 3, "transports": 2, "2026-07-28": 4, "server": 5, "tools": 3, "jul": 2, "resources": 2, "security": 9, "best": 2, "practices": 2, "draft": 2, "security_best_practices": 1, "typescript": 2, "sdk": 6, "github": 6, "repository": 4, "github.com": 3, "modelcontextprotocol": 3, "typescript-sdk": 1, "python": 2, "python-sdk": 1, "documentation": 3, "portal": 2, "ts.sdk.modelcontextprotocol.io": 1, "10": 1, "py.sdk.modelcontextprotocol.io": 1, "11": 1, "quickstart": 3, "guide": 4, "docs": 1, "12": 1, "registry": 4, "preview": 1, "official": 1, "blog": 3, "set": 2, "blog.modelcontextprotocol.io": 1, "posts": 1, "2025-09-08-mcp-registry-preview": 1, "13": 1, "14": 1, "fastest": 1, "way": 1, "discover": 1, "changelog": 2, "github.blog": 1, "2025-09-16-github-mcp-registry-the-fastest-way-to-discover-ai-tools": 1, "15": 1, "cloud": 1, "alliance": 1, "agentic": 3, "csa": 1, "labs": 3, "mar": 1, "labs.cloudsecurityalliance.org": 1, "agentic-mcp-security-best-practices-v1": 1, "16": 1, "invariant": 2, "notification": 1, "tool": 1, "poisoning": 1, "attacks": 1, "abr": 3, "invariantlabs.ai": 1, "mcp-security-notification-tool-poisoning-attacks": 1, "17": 1, "willison": 2, "simon": 2, "has": 1, "prompt": 1, "injection": 1, "problems": 1, "weblog": 1, "simonwillison.net": 1, "apr": 1, "mcp-prompt-injection": 1, "18": 1, "wang": 1, "zhen": 1, "al": 1, "tsinghua": 1, "university": 1, "ant": 1, "group": 1, "systematic": 1, "analysis": 1, "mcplib": 1, "arxiv": 1, "2508.12538": 1, "arxiv.org": 1, "html": 1, "2508.12538v1": 1, "19": 1, "cisa": 2, "secure": 1, "adoption": 1, "mai": 2, "www.cisa.gov": 1, "news-events": 1, "cisa-us-and-international-partners-release-guide-secure-adoption-agentic-ai": 1, "20": 1, "center": 1, "for": 2, "internet": 1, "cis": 3, "companion": 1, "controls": 1, "v8.1": 1, "white": 1, "papers": 1, "www.cisecurity.org": 1, "insights": 1, "white-papers": 1, "controls-v8-1-model-context-protocol-companion-guide": 1, "21": 1, "national": 1, "agency": 1, "nsa": 2, "design": 1, "considerations": 1, "ai-driven": 1, "automation": 1, "leveraging": 1, "press": 1, "release": 1, "www.nsa.gov": 1, "press-room": 1, "press-releases-statements": 1, "press-release-view": 1, "article": 1, "4496698": 1, "22": 1, "pulsemcp": 2, "directory": 1, "www.pulsemcp.com": 1, "servers": 1}, "norma": 35.20131887497179}, {"arquivo": "dossie_mcp-na-pratica-conectando-agentes-ao-mundo-real.md", "titulo": "Eixo 1 — Arquitetura MCP: host, client, server (MCP Specification, 2025–2026)", "texto": "O Model Context Protocol define um padrão aberto para integrar agentes de IA a ferramentas e dados externos:\n- **Host:** processo contêiner que coordena aplicações como o Claude Desktop ou IDEs de IA; gerencia múltiplas instâncias de cliente, políticas de autorização e ciclo de vida das conexões.\n- **Client:** wrapper de conexão 1:1 com um servidor MCP, mantendo sessão stateful e roteando mensagens JSON-RPC 2.0 bidirecionais sem expor o histórico da conversa fora do contexto designado.\n- **Server:** processo local ou serviço remoto que expõe capacidades e dados via primitivas padronizadas.\n- **Três primitivas:** Tools (funções executáveis controladas pelo modelo), Resources (dados endereçados por URI, app-driven) e Prompts (modelos de mensagem reutilizáveis).", "urls": [], "id": "B0003", "tokens": {"eixo": 1, "arquitetura": 1, "mcp": 3, "host": 2, "client": 2, "server": 2, "specification": 1, "2025": 1, "2026": 1, "model": 1, "context": 1, "protocol": 1, "define": 1, "padrao": 1, "aberto": 1, "integrar": 1, "agentes": 1, "ferramentas": 1, "dados": 3, "externos": 1, "processo": 2, "conteiner": 1, "coordena": 1, "aplicacoes": 1, "claude": 1, "desktop": 1, "ides": 1, "gerencia": 1, "multiplas": 1, "instancias": 1, "cliente": 1, "politicas": 1, "autorizacao": 1, "ciclo": 1, "vida": 1, "conexoes": 1, "wrapper": 1, "conexao": 1, "servidor": 1, "mantendo": 1, "sessao": 1, "stateful": 1, "roteando": 1, "mensagens": 1, "json-rpc": 1, "2.0": 1, "bidirecionais": 1, "expor": 1, "historico": 1, "conversa": 1, "fora": 1, "contexto": 1, "designado": 1, "local": 1, "servico": 1, "remoto": 1, "expoe": 1, "capacidades": 1, "via": 1, "primitivas": 2, "padronizadas": 1, "tres": 1, "tools": 1, "funcoes": 1, "executaveis": 1, "controladas": 1, "modelo": 1, "resources": 1, "enderecados": 1, "uri": 1, "app-driven": 1, "prompts": 1, "modelos": 1, "mensagem": 1, "reutilizaveis": 1}, "norma": 15.841038034883768}, {"arquivo": "dossie_mcp-na-pratica-conectando-agentes-ao-mundo-real.md", "titulo": "Eixo 2 — Transportes e versões da especificação", "texto": "- **stdio:** transporte padrão para integrações locais; o cliente lança o servidor como subprocesso e troca mensagens JSON-RPC 2.0 delimitadas por nova linha via stdin/stdout.\n- **Streamable HTTP:** substituiu o legado HTTP+SSE a partir da versão 2024-11-05; endpoint unificado com POST (JSON-RPC) e GET (Server-Sent Events), sessões via header `MCP-Session-Id`, resumibilidade via `Last-Event-ID` e validação de `Origin` contra ataques de DNS rebinding.\n- Especificações evolutivas: 2024-11-05 → 2025-11-25 → 2026-07-28 (linha estável v2 dos SDKs).", "urls": [], "id": "B0004", "tokens": {"eixo": 1, "transportes": 1, "versoes": 1, "especificacao": 1, "stdio": 1, "transporte": 1, "padrao": 1, "integracoes": 1, "locais": 1, "cliente": 1, "lanca": 1, "servidor": 1, "subprocesso": 1, "troca": 1, "mensagens": 1, "json-rpc": 2, "2.0": 1, "delimitadas": 1, "nova": 1, "linha": 2, "via": 3, "stdin": 1, "stdout": 1, "streamable": 1, "http": 2, "substituiu": 1, "legado": 1, "sse": 1, "partir": 1, "versao": 1, "2024-11-05": 2, "endpoint": 1, "unificado": 1, "post": 1, "get": 1, "server-sent": 1, "events": 1, "sessoes": 1, "header": 1, "mcp-session-id": 1, "resumibilidade": 1, "last-event-id": 1, "validacao": 1, "origin": 1, "contra": 1, "ataques": 1, "dns": 1, "rebinding": 1, "especificacoes": 1, "evolutivas": 1, "2025-11-25": 1, "2026-07-28": 1, "estavel": 1, "sdks": 1}, "norma": 14.52859126232918}, {"arquivo": "dossie_mcp-na-pratica-conectando-agentes-ao-mundo-real.md", "titulo": "Eixo 3 — Construindo servidores MCP do zero", "texto": "- **TypeScript:** SDK oficial sob a organização `modelcontextprotocol` no GitHub; documentação com tutorial de servidor em dez minutos; adaptadores finos opcionais (`@modelcontextprotocol/express`, `@modelcontextprotocol/hono`).\n- **Python:** SDK oficial instalável via `pip install \"mcp[cli]\"` ou `uv add \"mcp[cli]\"`; anotações de tipo Python atuam diretamente como schemas de validação (sem boilerplate de JSON Schema).\n- **Quickstart oficial:** servidor de clima expondo ferramentas `get-alerts` e `get-forecast` contra a National Weather Service API, conectado a um host como o Claude Desktop.", "urls": [], "id": "B0005", "tokens": {"eixo": 1, "construindo": 1, "servidores": 1, "mcp": 3, "zero": 1, "typescript": 1, "sdk": 2, "oficial": 3, "organizacao": 1, "modelcontextprotocol": 3, "github": 1, "documentacao": 1, "tutorial": 1, "servidor": 2, "dez": 1, "minutos": 1, "adaptadores": 1, "finos": 1, "opcionais": 1, "express": 1, "hono": 1, "python": 2, "instalavel": 1, "via": 1, "pip": 1, "install": 1, "cli": 2, "add": 1, "anotacoes": 1, "tipo": 1, "atuam": 1, "diretamente": 1, "schemas": 1, "validacao": 1, "boilerplate": 1, "json": 1, "schema": 1, "quickstart": 1, "clima": 1, "expondo": 1, "ferramentas": 1, "get-alerts": 1, "get-forecast": 1, "contra": 1, "national": 1, "weather": 1, "service": 1, "api": 1, "conectado": 1, "host": 1, "claude": 1, "desktop": 1}, "norma": 13.731836818901074}, {"arquivo": "dossie_mcp-na-pratica-conectando-agentes-ao-mundo-real.md", "titulo": "Eixo 4 — Consumindo servidores existentes: registro e ecossistema", "texto": "- **Registro oficial MCP** (preview em 8 set. 2025, apoiado por Anthropic, GitHub, Microsoft e PulseMCP): catálogo upstream de servidores públicos; GitHub anunciou o GitHub MCP Registry em 16 set. 2025.\n- **Ecossistema:** PulseMCP (22.000+ servidores em meados de 2026), Glama, MCP.so e Smithery (hosting/deploy de servidores comunitários).\n- Grande provedores mantêm servidores oficiais: Google Cloud (BigQuery), AWS (documentação), entre outros.", "urls": [], "id": "B0006", "tokens": {"eixo": 1, "consumindo": 1, "servidores": 5, "existentes": 1, "registro": 2, "ecossistema": 2, "oficial": 1, "mcp": 2, "preview": 1, "set": 2, "2025": 2, "apoiado": 1, "anthropic": 1, "github": 3, "microsoft": 1, "pulsemcp": 2, "catalogo": 1, "upstream": 1, "publicos": 1, "anunciou": 1, "registry": 1, "22.000": 1, "meados": 1, "2026": 1, "glama": 1, "mcp.so": 1, "smithery": 1, "hosting": 1, "deploy": 1, "comunitarios": 1, "grande": 1, "provedores": 1, "mantem": 1, "oficiais": 1, "google": 1, "cloud": 1, "bigquery": 1, "aws": 1, "documentacao": 1, "outros": 1}, "norma": 11.900685372857174}, {"arquivo": "dossie_mcp-na-pratica-conectando-agentes-ao-mundo-real.md", "titulo": "Eixo 5 — Segurança MCP: least-privilege, OAuth, audit logging, RBAC", "texto": "- **Least privilege:** tokens e capacidades de ferramentas com escopo mínimo; servidores só aceitam tokens emitidos para seu público específico (mitigação de reuso/passthrough).\n- **Autorização:** OAuth 2.1 com PKCE obrigatório para conexões remotas; mitigação de confused deputy com validação de consentimento por cliente, redirect URI com match exato e `state` criptograficamente seguro.\n- **Proibição de token passthrough:** servidores não podem aceitar tokens upstream e repassá-los a APIs de terceiros sem verificação de audiência e validação local.\n- **Audit logging:** registro de todas as invocações de ferramentas, decisões de política e mudanças de contexto, retido por mínimo de 90 dias em frameworks empresariais.\n- **CIS Companion Guide (abr. 2026):** aplicação dos CIS Controls v8.1 a implantações MCP — identidade, controle de acesso, logging e segurança de aplicação.", "urls": [], "id": "B0007", "tokens": {"eixo": 1, "seguranca": 2, "mcp": 2, "least-privilege": 1, "oauth": 2, "audit": 2, "logging": 3, "rbac": 1, "least": 1, "privilege": 1, "tokens": 3, "capacidades": 1, "ferramentas": 2, "escopo": 1, "minimo": 2, "servidores": 2, "aceitam": 1, "emitidos": 1, "publico": 1, "especifico": 1, "mitigacao": 2, "reuso": 1, "passthrough": 2, "autorizacao": 1, "2.1": 1, "pkce": 1, "obrigatorio": 1, "conexoes": 1, "remotas": 1, "confused": 1, "deputy": 1, "validacao": 2, "consentimento": 1, "cliente": 1, "redirect": 1, "uri": 1, "match": 1, "exato": 1, "state": 1, "criptograficamente": 1, "seguro": 1, "proibicao": 1, "token": 1, "podem": 1, "aceitar": 1, "upstream": 1, "repassa-los": 1, "apis": 1, "terceiros": 1, "verificacao": 1, "audiencia": 1, "local": 1, "registro": 1, "todas": 1, "invocacoes": 1, "decisoes": 1, "politica": 1, "mudancas": 1, "contexto": 1, "retido": 1, "dias": 1, "frameworks": 1, "empresariais": 1, "cis": 2, "companion": 1, "guide": 1, "abr": 1, "2026": 1, "aplicacao": 2, "controls": 1, "v8.1": 1, "implantacoes": 1, "identidade": 1, "controle": 1, "acesso": 1}, "norma": 17.71616367829982}, {"arquivo": "dossie_mcp-na-pratica-conectando-agentes-ao-mundo-real.md", "titulo": "Eixo 6 — Riscos documentados (porta de entrada não revisada)", "texto": "- **Prompt injection via MCP:** LLMs não distinguem comandos do usuário, dados da aplicação e instruções embutidas em saídas/descrições de ferramentas (Willison, 2025).\n- **Tool Poisoning Attacks (Invariant Labs, abr. 2025):** instruções adversárias escondidas em descrições de ferramentas (tags `<IMPORTANT>`, comentários de código) que induzem o modelo a executar ações não autorizadas e exfiltrar dados por argumentos não usados.\n- **Cross-server tool shadowing:** servidores maliciosos injetam instruções que sequestram ferramentas confiáveis em contexto compartilhado.\n- **SSRF:** servidores remotos maliciosos retornam URLs em endpoints de descoberta OAuth apontando para redes internas (`192.168.x.x`) ou metadados de nuvem (`169.254.169.254`).\n- **CVE-2025-6514 (JFrog):** RCE pré-autenticação (CVSS 9.6) no pacote `mcp-remote` — `authorization_endpoint` não validado passado a execução de shell.\n- **MCPLib (Tsinghua/Ant Group, ago. 2025):** taxonomia com 31 tipos de ataque MCP (injeção direta/indireta de ferramentas, ataques de usuários maliciosos e exploits inerentes ao LLM).\n- **Local server compromise:** binários locais herdam privilégios do cliente; sem sandboxing podem exfiltrar arquivos sensíveis (`~/.ssh/id_rsa`).", "urls": [], "id": "B0008", "tokens": {"eixo": 1, "riscos": 1, "documentados": 1, "porta": 1, "entrada": 1, "revisada": 1, "prompt": 1, "injection": 1, "via": 1, "mcp": 2, "llms": 1, "distinguem": 1, "comandos": 1, "usuario": 1, "dados": 2, "aplicacao": 1, "instrucoes": 3, "embutidas": 1, "saidas": 1, "descricoes": 2, "ferramentas": 4, "willison": 1, "2025": 3, "tool": 2, "poisoning": 1, "attacks": 1, "invariant": 1, "labs": 1, "abr": 1, "adversarias": 1, "escondidas": 1, "tags": 1, "important": 1, "comentarios": 1, "codigo": 1, "induzem": 1, "modelo": 1, "executar": 1, "acoes": 1, "autorizadas": 1, "exfiltrar": 2, "argumentos": 1, "usados": 1, "cross-server": 1, "shadowing": 1, "servidores": 2, "maliciosos": 3, "injetam": 1, "sequestram": 1, "confiaveis": 1, "contexto": 1, "compartilhado": 1, "ssrf": 1, "remotos": 1, "retornam": 1, "urls": 1, "endpoints": 1, "descoberta": 1, "oauth": 1, "apontando": 1, "redes": 1, "internas": 1, "192.168.x.x": 1, "metadados": 1, "nuvem": 1, "169.254.169.254": 1, "cve-2025-6514": 1, "jfrog": 1, "rce": 1, "pre-autenticacao": 1, "cvss": 1, "9.6": 1, "pacote": 1, "mcp-remote": 1, "authorization_endpoint": 1, "validado": 1, "passado": 1, "execucao": 1, "shell": 1, "mcplib": 1, "tsinghua": 1, "ant": 1, "group": 1, "ago": 1, "taxonomia": 1, "tipos": 1, "ataque": 1, "injecao": 1, "direta": 1, "indireta": 1, "ataques": 1, "usuarios": 1, "exploits": 1, "inerentes": 1, "llm": 1, "local": 1, "server": 1, "compromise": 1, "binarios": 1, "locais": 1, "herdam": 1, "privilegios": 1, "cliente": 1, "sandboxing": 1, "podem": 1, "arquivos": 1, "sensiveis": 1, "ssh": 1, "id_rsa": 1}, "norma": 19.88242619280284}, {"arquivo": "dossie_mcp-na-pratica-conectando-agentes-ao-mundo-real.md", "titulo": "Eixo 7 — MCP Engineering como disciplina", "texto": "- Decisão central: **o que expor, com que granularidade e com que controle de acesso** — a superfície de ataque do agente é a soma das ferramentas conectadas.\n- Esquemas least-privilege: expor o menor conjunto de ferramentas com os menores escopos necessários à tarefa.\n- Três fronteiras de confiança (CSA, 2026): LLM↔Client, Client↔Server, Server↔Sistemas downstream — cada uma com controles próprios.\n- Guias governamentais: CISA (mai. 2026) integra agentic AI a Zero Trust; NSA (mai. 2026) recomenda isolamento em runtime, atestação e enforcement de fronteiras.", "urls": [], "id": "B0009", "tokens": {"eixo": 1, "mcp": 1, "engineering": 1, "disciplina": 1, "decisao": 1, "central": 1, "expor": 2, "granularidade": 1, "controle": 1, "acesso": 1, "superficie": 1, "ataque": 1, "agente": 1, "soma": 1, "ferramentas": 2, "conectadas": 1, "esquemas": 1, "least-privilege": 1, "menor": 1, "conjunto": 1, "menores": 1, "escopos": 1, "necessarios": 1, "tarefa": 1, "tres": 1, "fronteiras": 2, "confianca": 1, "csa": 1, "2026": 3, "llm": 1, "client": 2, "server": 2, "sistemas": 1, "downstream": 1, "cada": 1, "controles": 1, "proprios": 1, "guias": 1, "governamentais": 1, "cisa": 1, "mai": 2, "integra": 1, "agentic": 1, "zero": 1, "trust": 1, "nsa": 1, "recomenda": 1, "isolamento": 1, "runtime": 1, "atestacao": 1, "enforcement": 1}, "norma": 13.33508953649177}, {"arquivo": "dossie_mcp-na-pratica-conectando-agentes-ao-mundo-real.md", "titulo": "3. Métricas de mercado (2026)", "texto": "- PulseMCP cataloga 22.000+ servidores MCP (meados de 2026), refletindo adoção massiva e superfície de ataque crescente.\n- Ataques de tool poisoning demonstrados em ferramentas reais (Cursor, Claude Desktop) com exfiltração prática (Invariant Labs, abr. 2025).\n- O pacote `mcp-remote` atingia 437.000+ ambientes de instalação quando a CVE-2025-6514 (CVSS 9.6) foi divulgada.", "urls": [], "id": "B0010", "tokens": {"metricas": 1, "mercado": 1, "2026": 2, "pulsemcp": 1, "cataloga": 1, "22.000": 1, "servidores": 1, "mcp": 1, "meados": 1, "refletindo": 1, "adocao": 1, "massiva": 1, "superficie": 1, "ataque": 1, "crescente": 1, "ataques": 1, "tool": 1, "poisoning": 1, "demonstrados": 1, "ferramentas": 1, "reais": 1, "cursor": 1, "claude": 1, "desktop": 1, "exfiltracao": 1, "pratica": 1, "invariant": 1, "labs": 1, "abr": 1, "2025": 1, "pacote": 1, "mcp-remote": 1, "atingia": 1, "437.000": 1, "ambientes": 1, "instalacao": 1, "cve-2025-6514": 1, "cvss": 1, "9.6": 1, "divulgada": 1}, "norma": 9.876910129640496}]}