{
  "plataforma": "hotmart",
  "webhook_secret": "{{HOTMART_WEBHOOK_SECRET}}",
  "webhook_url": "{{SITE_URL}}/api/webhooks/pagamento",
  "eventos": {
    "compra_aprovada": {
      "acao": "mover_para_compradores",
      "tags_adicionar": ["comprou"],
      "tags_remover": ["lead", "nutricao"],
      "funil_upsell": "upsell-masterclass",
      "delay_upsell_horas": 48
    },
    "compra_cancelada": {
      "acao": "mover_para_cancelados",
      "tags_adicionar": ["cancelado"],
      "email_cancelamento": true
    },
    "reembolso": {
      "acao": "mover_para_reembolsados",
      "tags_adicionar": ["reembolsado"],
      "bloquear_upsell": true
    },
    "assinatura_renovada": {
      "acao": "manter_ativo",
      "tags_adicionar": ["renovado"],
      "email_parabens": true
    },
    "assinatura_expirada": {
      "acao": "mover_para_churn",
      "tags_adicionar": ["churn"],
      "funil_retencao": "reativacao",
      "delay_retencao_horas": 24
    }
  },
  "cupons": {
    "LANCTO30": {
      "desconto": 30,
      "tipo": "percentual",
      "validade": "2026-12-31",
      "usos_max": 100,
      "usos_atual": 0,
      "produtos": ["livro-autor-digital"]
    },
    "VOLTEI20": {
      "desconto": 20,
      "tipo": "percentual",
      "validade": "2026-12-31",
      "usos_max": 50,
      "usos_atual": 0,
      "produtos": ["livro-autor-digital", "bundle-marketing-digital"]
    }
  }
}
