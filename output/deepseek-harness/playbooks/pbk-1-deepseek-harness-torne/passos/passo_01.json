{
  "numero": 1,
  "titulo": "Instalar e Configurar o Ecossistema",
  "estagio": "Estação de Montagem",
  "origem": "Cap. 1",
  "objetivo": "Configurar o ambiente de desenvolvimento com DeepSeek Harness, API key e verificação de integração.",
  "pre_requisito": "Node.js 18+, Python 3.10+, conta em platform.deepseek.com",
  "entregas": [
    "output/deepseek-harness/harness-instalado.md — relatório de instalação",
    ".env — DEEPSEEK_API_KEY configurada",
    "scripts/verificar_ecossistema.sh — script de smoke test"
  ],
  "execucao": [
    {
      "titulo": "Instalar Harness",
      "codigo": "npx @deepseek-ai/dsh web"
    },
    {
      "titulo": "Configurar API Key",
      "codigo": "export DEEPSEEK_API_KEY=\"sk-sua-chave\"\necho 'export DEEPSEEK_API_KEY=\"sk-sua-chave\"' >> ~/.bashrc"
    },
    {
      "titulo": "Verificar Integração",
      "codigo": "curl -s https://api.deepseek.com/models -H \"Authorization: Bearer ${DEEPSEEK_API_KEY}\""
    }
  ],
  "gate": "curl retorna JSON com lista de modelos (deepseek-v4-flash, deepseek-v4-pro)",
  "feito_quando": [
    "npx @deepseek-ai/dsh web abre sem erro",
    "DEEPSEEK_API_KEY retorna models no endpoint /models",
    "variável persiste entre sessões (novo terminal)",
    "harness-webui acessível em http://127.0.0.1:3080"
  ],
  "armadilhas": [
    "Usar endpoint /anthropic no lugar do / (formato errado = erro 400)",
    "Esquecer DEEPSEEK_API_KEY no .bashrc (some entre sessões)",
    "Rodar em Python < 3.10 (tipo union X | Y não suportado)"
  ],
  "arquivos_citados": ["~/.bashrc", ".env"]
}