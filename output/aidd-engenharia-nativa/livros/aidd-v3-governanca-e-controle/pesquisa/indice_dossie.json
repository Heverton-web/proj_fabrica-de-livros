rnational": 1, "workshop": 1, "engineering": 1, "botse": 1, "botse67031.2025.00012": 1, "peng": 1, "sheng-wei": 1, "lin": 1, "yi-hsun": 1, "lee": 1, "yi-pei": 1, "inference": 1, "economics": 1, "enterprise": 1, "coding": 1, "case": 1, "study": 1, "cloud": 1, "vs": 1, "on-premise": 1, "llms": 1, "2607.13080": 1}, "norma": 12.642637461402089}, {"arquivo": "dossie_aidd-v3.md", "titulo": "Estado da arte / ferramentas de referência", "texto": "- **GitHub Spec Kit**: loop formal de quatro fases (specify, plan, tasks, implement); documento da abordagem spec-as-source. Disponível em: https://github.com/github/spec-kit\n- **Amazon Kiro**: fluxo stage-gated sequencial que produz requirements.md, design.md e tasks.md antes de qualquer código. Disponível em: https://kiro.dev\n- **AGENTS.md (open standard)**: formato suportado em mais de 20 ferramentas (Codex, Cursor, Jules, VS Code) para setup, estilo de código e fronteiras arquiteturais em um arquivo legível por máquina. Disponível em: https://agents.md\n- **cc-sdd**: CLI comunitária que instala fluxos SDD como skills (EARS, critérios de aceite, design com Mermaid, TDD por tarefa). Disponível em: https://github.com/codegen-ai/cc-sdd\n- **CLAUDE.md (Anthropic)**: carregado na raiz do repositório no início da sessão; fonte de contexto permanente do projeto. Disponível em: https://code.claude.com/docs/en/context\n- **DeepLearning.AI — SDD com Coding Agents**: curso que formaliza constitution do projeto + feature specs para preservar contexto e reduzir dívida cognitiva. Disponível em: https://www.deeplearning.ai/courses/spec-driven-development-with-coding-agents", "urls": ["https://agents.md", "https://code.claude.com/docs/en/context", "https://github.com/codegen-ai/cc-sdd", "https://github.com/github/spec-kit", "https://kiro.dev", "https://www.deeplearning.ai/courses/spec-driven-development-with-coding-agents"], "id": "B0003", "tokens": {"estado": 1, "arte": 1, "ferramentas": 2, "referencia": 1, "github": 2, "spec": 1, "kit": 1, "loop": 1, "formal": 1, "quatro": 1, "fases": 1, "specify": 1, "plan": 1, "tasks": 1, "implement": 1, "documento": 1, "abordagem": 1, "spec-as-source": 1, "disponivel": 6, "https": 6, "github.com": 2, "spec-kit": 1, "amazon": 1, "kiro": 1, "fluxo": 1, "stage-gated": 1, "sequencial": 1, "produz": 1, "requirements.md": 1, "design.md": 1, "tasks.md": 1, "antes": 1, "qualquer": 1, "codigo": 2, "kiro.dev": 1, "agents.md": 2, "open": 1, "standard": 1, "formato": 1, "suportado": 1, "codex": 1, "cursor": 1, "jules": 1, "code": 1, "setup": 1, "estilo": 1, "fronteiras": 1, "arquiteturais": 1, "arquivo": 1, "legivel": 1, "maquina": 1, "cc-sdd": 2, "cli": 1, "comunitaria": 1, "instala": 1, "fluxos": 1, "sdd": 2, "skills": 1, "ears": 1, "criterios": 1, "aceite": 1, "design": 1, "mermaid": 1, "tdd": 1, "tarefa": 1, "codegen-ai": 1, "claude.md": 1, "anthropic": 1, "carregado": 1, "raiz": 1, "repositorio": 1, "inicio": 1, "sessao": 1, "fonte": 1, "contexto": 2, "permanente": 1, "projeto": 2, "code.claude.com": 1, "docs": 1, "context": 1, "deeplearning.ai": 1, "coding": 1, "agents": 1, "curso": 1, "formaliza": 1, "constitution": 1, "feature": 1, "specs": 1, "preservar": 1, "reduzir": 1, "divida": 1, "cognitiva": 1, "www.deeplearning.ai": 1, "courses": 1, "spec-driven-development-with-coding-agents": 1}, "norma": 16.668191161461014}, {"arquivo": "dossie_aidd-v3.md", "titulo": "Casos de uso corporativos", "texto": "- **Spec-as-source em Tessl**: código marcado \"GENERATED FROM SPEC - DO NOT EDIT\"; edita-se a spec e regenera-se o código — elimina drift por construção.\n- **Kiro autopilot hooks**: agentes observam eventos (arquivo salvo, teste falhou, PR aberto) e checam automaticamente contra a spec; divergência é sinalizada antes da revisão.\n- **Fluxos SDD com Spec Kit + Claude Code**: requirements antes de feature, design revisado antes de aprovar, tasks numeradas executadas uma a uma — menos premissas erradas, menos reescritas.\n- **Constitution de projeto**: teams preservam decisões entre sessões com AGENTS.md/CLAUDE.md, evitando context collapse em projetos multi-sessão.", "urls": [], "id": "B0004", "tokens": {"casos": 1, "uso": 1, "corporativos": 1, "spec-as-source": 1, "tessl": 1, "codigo": 2, "marcado": 1, "generated": 1, "from": 1, "spec": 4, "not": 1, "edit": 1, "edita-se": 1, "regenera-se": 1, "elimina": 1, "drift": 1, "construcao": 1, "kiro": 1, "autopilot": 1, "hooks": 1, "agentes": 1, "observam": 1, "eventos": 1, "arquivo": 1, "salvo": 1, "teste": 1, "falhou": 1, "aberto": 1, "checam": 1, "automaticamente": 1, "contra": 1, "divergencia": 1, "sinalizada": 1, "antes": 3, "revisao": 1, "fluxos": 1, "sdd": 1, "kit": 1, "claude": 1, "code": 1, "requirements": 1, "feature": 1, "design": 1, "revisado": 1, "aprovar": 1, "tasks": 1, "numeradas": 1, "executadas": 1, "menos": 2, "premissas": 1, "erradas": 1, "reescritas": 1, "constitution": 1, "projeto": 1, "teams": 1, "preservam": 1, "decisoes": 1, "sessoes": 1, "agents.md": 1, "claude.md": 1, "evitando": 1, "context": 1, "collapse": 1, "projetos": 1, "multi-sessao": 1}, "norma": 13.037896624792124}, {"arquivo": "dossie_aidd-v3.md", "titulo": "Limitações e controvérsias", "texto": "- **Spec drift**: se a spec não é atualizada junto com o código, o drift corrói o benefício; critérios objetivos de revisão são essenciais.\n- **Overhead**: para tarefas <15 min, o overhead de spec não compensa; break-even aproximado: se o agente precisar de mais de dois ciclos de correção, escreva a spec.\n- **SDD vs. vibe coding**: SDD é explicitamente posicionado contra o prompt-and-pray; mas sem disciplina o SDD vira documentação morta.\n- **Hallucinated interfaces**: sem spec, o agente inventa método de API/config/db que compila e falha em runtime — spec previne.\n- **Context collapse**: tarefas multi-sessão/multi-arquivo perdem decisões anteriores; especificações registradas mitigam.\n- **Ferramentas em beta**: Spec Kit/Kiro/Tessl/cc-sdd consolidam em 2026; sem padrão único estabelecido.", "urls": [], "id":