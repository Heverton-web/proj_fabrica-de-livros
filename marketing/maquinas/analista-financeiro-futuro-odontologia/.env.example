# =============================================================================
# Máquina de Vendas — Variáveis de Ambiente
# Copie para .env e preencha os valores
# =============================================================================

# --- Geral ---
APP_ENV=development
APP_SECRET_KEY={{APP_SECRET_KEY}}
SITE_URL=http://localhost:3000
LOG_LEVEL=INFO

# --- Backend (rota /api/checkout e /api/lead do Next.js) ---
# URL do backend FastAPI. Padrão: http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# --- Banco de Dados ---
DATABASE_PATH=./database/leads.db

# --- Instagram Graph API ---
INSTAGRAM_ACCESS_TOKEN={{INSTAGRAM_ACCESS_TOKEN}}
INSTAGRAM_APP_ID={{INSTAGRAM_APP_ID}}
INSTAGRAM_APP_SECRET={{INSTAGRAM_APP_SECRET}}

# --- SMTP / E-mail ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER={{SMTP_USER}}
SMTP_PASSWORD={{SMTP_PASSWORD}}
FROM_EMAIL={{FROM_EMAIL}}
FROM_NAME=Fábrica de Livros

# --- Tracking ---
TRACKING_DOMAIN={{TRACKING_DOMAIN}}

# --- Pagamento (Hotmart) ---
HOTMART_WEBHOOK_SECRET={{HOTMART_WEBHOOK_SECRET}}
HOTMART_CLIENT_ID={{HOTMART_CLIENT_ID}}
HOTMART_CLIENT_SECRET={{HOTMART_CLIENT_SECRET}}

# --- OpenAI (para geração de copy) ---
OPENAI_API_KEY={{OPENAI_API_KEY}}
OPENAI_MODEL=gpt-4o-mini

# --- VPS Deploy ---
VPS_HOST=
VPS_USER=root
VPS_PATH=/opt/maquina-vendas

# --- Vercel ---
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# --- Webhooks / Alertas ---
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# --- Rate Limits ---
MAX_EMAILS_PER_HOUR=30
MAX_EMAILS_PER_DAY=200
MAX_LEADS_PER_DAY=100
